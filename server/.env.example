# ═══════════════════════════════════════════════════════════════
# Internal Cloud - Konfigurasi Server
# Salin file ini menjadi .env lalu isi sesuai kebutuhan
# ═══════════════════════════════════════════════════════════════

# Port & host server
PORT=3000
HOST=0.0.0.0

# URL dasar (untuk redirect OAuth). Ganti ke IP LAN jika akses dari HP dalam jaringan sama.
# Contoh: http://192.168.1.21:3000
BASE_URL=http://localhost:3000

# Secret JWT - GANTI dengan string acak panjang di produksi
JWT_SECRET=ganti-ini-secret-panjang-acak
JWT_EXPIRES_IN=7d

# Maks upload (MB)
MAX_FILE_SIZE_MB=50

# Ekstensi yang diizinkan (whitelist)
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,pptx,txt,csv,png,jpg,jpeg,gif,webp,zip,rar,7z

# ═══════════════════════════════════════════════════════════════
# Penyimpanan file (default: local)
# STORAGE_DRIVER=local
# Untuk S3-compatible storage, set:
# STORAGE_DRIVER=s3
# S3_BUCKET=nama-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT=https://...            # isi untuk MinIO / R2 / GCS / lainnya
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx
# S3_PREFIX=internal-cloud
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# Google Drive (untuk menyimpan file ke Google Drive pribadi)
# 1. Buat project di https://console.cloud.google.com
# 2. Aktifkan Google Drive API & People API
# 3. Buat OAuth 2.0 Client ID (tipe: Web)
# 4. Authorized redirect URI harus = <BASE_URL>/api/drive/callback
#    Contoh: http://localhost:3000/api/drive/callback
# 5. Isi di bawah:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
# Nama folder di Google Drive tempat file disimpan
DRIVE_FOLDER_NAME=Internal Cloud
# ═══════════════════════════════════════════════════════════════

# Lokasi data (default: server/data)
# DATA_DIR=../data
